{
  "name": "ozisanat-api",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "nodemon app.js",
    "reset": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "migrate": "npx sequelize-cli db:migrate",
    "un-migrate-all": "npx sequelize-cli db:migrate:undo:all",
    "un-migrate-back": "npx sequelize-cli db:migrate:undo",
    "seed-all": "npx sequelize-cli db:seed:all",
    "seed-undo-all": "npx sequelize-cli db:seed:undo:all",
    "generate-model": "npx sequelize-cli model:generate --name User --attributes id:integer,firstName:string,lastName:string,email:string",
    "generate-seed": "npx sequelize-cli seed:generate --name demo-user",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@babel/register": "^7.18.9",
    "nodemon": "^2.0.20",
    "sequelize-cli": "^6.5.2"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "luxon": "^3.1.0",
    "mysql2": "^2.3.3",
    "sequelize": "^6.25.5"
  }
}
